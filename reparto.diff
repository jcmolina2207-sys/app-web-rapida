+
+// ------------------------------------------------------------------
+// "¿Qué hacer con este ingreso?" — desglose sugerido de reparto
+// (Finanzas > Reportes). Es puramente informativo/visual: no genera
+// movimientos, no toca state.movimientos ni el saldo real. Los % salen
+// de state.config.reparto (configurables desde openConfigReparto()).
+// ------------------------------------------------------------------
+function renderReporteReparto() {
+  const ingresos = state.movimientos
+    .filter(m => m.tipo === 'income')
+    .sort((a, b) => b.fecha.localeCompare(a.fecha) || b.id - a.id)
+    .slice(0, 50);
+
+  const r = state.config.reparto || { materiaPrima: 55, ahorro: 25, sueldo: 15, colchon: 5 };
+
+  // Si el movimiento seleccionado ya no existe (ej: se borró), soltarlo.
+  if (repartoMovId !== null && !ingresos.some(m => m.id === repartoMovId)) {
+    repartoMovId = null;
+  }
+
+  const opciones = ingresos.map(m =>
+    `<option value="${m.id}" ${m.id === repartoMovId ? 'selected' : ''}>${m.descripcion} — ${fmt(m.monto)} (${m.fecha})</option>`
+  ).join('');
+
+  const movSel = ingresos.find(m => m.id === repartoMovId);
+
+  const partidas = [
+    { key: 'materiaPrima', label: '🧂 Materia prima / insumos', color: 'var(--accent)' },
+    { key: 'ahorro',       label: '🐖 Ahorro / reinversión',    color: 'var(--green)' },
+    { key: 'sueldo',       label: '👩‍🍳 Sueldo de Sofía',        color: 'var(--gold, var(--accent))' },
+    { key: 'colchon',      label: '🛟 Colchón / imprevistos',    color: 'var(--text3)' },
+  ];
+
+  const desglose = !movSel ? '' : partidas.map(p => {
+    const pct = r[p.key] || 0;
+    const monto = Math.round(movSel.monto * pct / 100);
+    return `
+      <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px">
+        <div style="flex:1;min-width:0">
+          <div style="display:flex;justify-content:space-between;gap:8px;font-size:12.5px;margin-bottom:4px">
+            <span style="font-weight:700;color:var(--text)">${p.label}</span>
+            <span style="font-weight:700;color:var(--text)">${fmt(monto)} <span style="color:var(--text3);font-weight:600">(${pct}%)</span></span>
+          </div>
+          <div style="background:var(--surface2);border-radius:6px;height:7px;overflow:hidden">
+            <div style="width:${Math.max(2, pct)}%;height:100%;background:${p.color};border-radius:6px"></div>
+          </div>
+        </div>
+      </div>`;
+  }).join('');
+
+  return `
+    <div style="background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-sm);padding:14px 12px;margin-top:12px;box-shadow:var(--shadow)">
+      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:4px;gap:8px">
+        <div style="font-weight:700;font-size:14px;color:var(--text)">💡 ¿Qué hacer con este ingreso?</div>
+        <button class="btn btn-ghost btn-sm" onclick="openConfigReparto()">⚙️ Configurar</button>
+      </div>
+      <div style="font-size:11px;color:var(--text3);margin-bottom:12px">Sugerencia de distribución sobre un ingreso puntual — es sólo una guía, no genera movimientos ni modifica el saldo real.</div>
+
+      ${ingresos.length === 0
+        ? `<div class="empty-state" style="padding:12px 0"><p style="font-size:12px">Todavía no hay ingresos registrados</p></div>`
+        : `
+          <select class="form-input" style="margin-bottom:${movSel ? '12px' : '0'}" onchange="setRepartoMov(this.value)">
+            <option value="">Elegí un ingreso…</option>
+            ${opciones}
+          </select>
+          ${desglose}
+        `
+      }
+    </div>
   `;
 }
 
+function setRepartoMov(id) {
+  repartoMovId = id === '' ? null : Number(id);
+  renderFinanzas();
+}
+
+function openConfigReparto() {
+  const r = state.config.reparto || { materiaPrima: 55, ahorro: 25, sueldo: 15, colchon: 5 };
+  const etapaBtns = Object.entries(REPARTO_ETAPAS).map(([key, e]) =>
+    `<button type="button" class="btn btn-ghost btn-sm" onclick="aplicarEtapaReparto('${key}')">${e.label}</button>`
+  ).join('');
+
+  openModal(`
+    <div class="modal-title">⚙️ Reparto sugerido del ingreso</div>
+    <div style="font-size:11px;color:var(--text3);margin-bottom:12px">Los 4 porcentajes deben sumar 100%. Se usan sólo como guía visual en Finanzas &gt; Reportes.</div>
+
+    <div class="form-group">
+      <label class="form-label">🧂 Materia prima / insumos (%)</label>
+      <input class="form-input" id="f-reparto-materia" type="number" min="0" max="100" step="1" value="${r.materiaPrima}">
+    </div>
+    <div class="form-group">
+      <label class="form-label">🐖 Ahorro / reinversión (%)</label>
+      <input class="form-input" id="f-reparto-ahorro" type="number" min="0" max="100" step="1" value="${r.ahorro}">
+    </div>
+    <div class="form-group">
+      <label class="form-label">👩‍🍳 Sueldo de Sofía (%)</label>
+      <input class="form-input" id="f-reparto-sueldo" type="number" min="0" max="100" step="1" value="${r.sueldo}">
+    </div>
+    <div class="form-group">
+      <label class="form-label">🛟 Colchón / imprevistos (%)</label>
+      <input class="form-input" id="f-reparto-colchon" type="number" min="0" max="100" step="1" value="${r.colchon}">
+    </div>
+
+    <div class="form-group">
+      <label class="form-label">Presets por etapa del negocio</label>
+      <div style="display:flex;gap:8px;flex-wrap:wrap">${etapaBtns}</div>
+    </div>
+
+    <div id="f-reparto-error" style="font-size:11.5px;color:var(--red);margin-bottom:8px;display:none">Los porcentajes deben sumar 100%.</div>
+
+    <div class="modal-actions">
+      <button class="btn btn-ghost w-100" onclick="closeModal()">Cancelar</button>
+      <button class="btn btn-primary w-100" onclick="saveConfigReparto()">💾 Guardar</button>
+    </div>
+  `);
+}
+
+function aplicarEtapaReparto(key) {
+  const e = REPARTO_ETAPAS[key];
+  if (!e) return;
+  document.getElementById('f-reparto-materia').value = e.materiaPrima;
+  document.getElementById('f-reparto-ahorro').value = e.ahorro;
+  document.getElementById('f-reparto-sueldo').value = e.sueldo;
+  document.getElementById('f-reparto-colchon').value = e.colchon;
+}
+
+function saveConfigReparto() {
+  const materiaPrima = parseFloat(document.getElementById('f-reparto-materia').value) || 0;
+  const ahorro = parseFloat(document.getElementById('f-reparto-ahorro').value) || 0;
+  const sueldo = parseFloat(document.getElementById('f-reparto-sueldo').value) || 0;
+  const colchon = parseFloat(document.getElementById('f-reparto-colchon').value) || 0;
+  const suma = materiaPrima + ahorro + sueldo + colchon;
+
+  if (Math.round(suma) !== 100) {
+    document.getElementById('f-reparto-error').style.display = 'block';
+    document.getElementById('f-reparto-error').textContent = `Los porcentajes suman ${suma}%, deben sumar 100%.`;
+    return;
+  }
+
+  state.config.reparto = { materiaPrima, ahorro, sueldo, colchon };
+  saveState(); closeModal();
+  showToast('⚙️ Reparto actualizado');
+  renderScreen(activeScreen);
+}
